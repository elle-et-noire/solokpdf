+struct PdfiumRenderScope : NonCopyable {
+    static SRWLOCK lock;
+    bool largeTile;
+
+    explicit PdfiumRenderScope(u64 bytes) : largeTile(bytes > kLargePdfiumTileBytes) {
+        if (largeTile) {
+            AcquireSRWLockExclusive(&lock);
+        } else {
+            AcquireSRWLockShared(&lock);
+        }
+    }
+
+    ~PdfiumRenderScope() {
+        if (largeTile) {
+            ReleaseSRWLockExclusive(&lock);
+        } else {
+            ReleaseSRWLockShared(&lock);
+        }
+    }
+};
+SRWLOCK PdfiumRenderScope::lock = SRWLOCK_INIT;
