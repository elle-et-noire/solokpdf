@@ -69,7 +69,7 @@ pdf_filter_resources(fz_context *ctx, pdf_document *doc, pdf_obj *in_res, pdf_ob
 			if (smask)
 			{
 				pdf_obj *g = pdf_dict_get(ctx, smask, PDF_NAME(G));
-				if (g)
+				if (g && !options->preserve_soft_masks)
