pdf: preserve soft masks during color filtering

Allow filters to leave opacity and luminosity masks unchanged.

diff --git a/include/mupdf/pdf/interpret.h b/include/mupdf/pdf/interpret.h
index 6e1603bec..38bb3f14e 100644
--- a/include/mupdf/pdf/interpret.h
+++ b/include/mupdf/pdf/interpret.h
@@ -314,6 +314,8 @@ typedef struct
 	create a new instance of each XObject Form that is used, filtered
 	individually.
 
+	preserve_soft_masks: Leave soft mask groups unchanged.
+
 	ascii: If true, escape all binary data in the output.
 
 	no_update: If true, do not update the document at the end.
@@ -345,6 +347,7 @@ struct pdf_filter_options
 
 	pdf_filter_factory *filters;
 	int newlines;
+	int preserve_soft_masks;
 };
 
 typedef enum
