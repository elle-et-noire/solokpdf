 				else
 					fz_throw(ctx, FZ_ERROR_SYNTAX, "unknown colorspace %s", pdf_to_name(ctx, name));
 
+				if (pdf_name_eq(ctx, name, PDF_NAME(Pattern)) && !pdf_is_indirect(ctx, obj) && pdf_is_indirect(ctx, sub))
